{% extends "_layouts/cp" %}

{% import "influx/_overview" as ui %}

{% set title = "Logs"|t("influx") %}
{% set selectedSubnavItem = "logs" %}

{% set canDelete = craft.influx.permissions.can("influx:deleteLogs") %}

{# Active filters, carried through the pager links so paging keeps the view. #}
{% set filterParams = { link: selectedLink, status: selectedStatus, trigger: selectedTrigger, result: selectedResult }|filter(v => v is not null and v != "") %}

{# The result kinds, labelled with the same nouns the Result column's pills use
   so the filter and the rows can't word a kind differently. #}
{% set resultLabels = {} %}
{% for value in results %}
    {% set resultLabels = resultLabels|merge({ (value): ui.resultNoun(value)|capitalize }) %}
{% endfor %}

{# The toolbar's filters, declared once and rendered in a loop: each is a select
   over its own `value: label` map, holding whatever the URL asked for. Adding a
   fifth filter is an entry here plus its query param. #}
{% set filterFields = [
    { name: "link",    label: "Link"|t("influx"),    options: linkNames,    value: selectedLink },
    { name: "trigger", label: "Trigger"|t("influx"), options: triggers,     value: selectedTrigger },
    { name: "status",  label: "Status"|t("influx"),  options: statuses,     value: selectedStatus },
    { name: "result",  label: "Result"|t("influx"),  options: resultLabels, value: selectedResult },
] %}

{% block actionButton %}
    {% if canDelete %}
        <form method="post" accept-charset="UTF-8" onsubmit="return confirm('{{ "Delete every log entry?"|t("influx") }}');">
            {{ csrfInput() }}
            {{ actionInput("influx/logs/clear") }}
            <button type="submit" class="btn" data-icon="trash">{{ "Clear all"|t("influx") }}</button>
        </form>
    {% endif %}
{% endblock %}

{% block content %}
    {% js %}
    document.querySelectorAll('[data-influx-delete-form]').forEach(function (anchor) {
        anchor.addEventListener('click', function () {
            if (window.confirm({{ "Delete this log entry?"|t("influx")|json_encode|raw }})) {
                document.getElementById(anchor.dataset.influxDeleteForm).submit();
            }
        });
    });

    // Filter selects submit their GET form on change; dropping the page param
    // (it isn't in the form) resets to page 1 for the new filter.
    document.querySelectorAll('[data-influx-filter]').forEach(function (select) {
        select.addEventListener('change', function () {
            this.form.submit();
        });
    });
    {% endjs %}

    {# Filter by link, trigger, status and/or result kind without leaving the
       page. A result kind selects the runs whose counter for it moved, so
       "Updated" answers "which runs changed anything".

       Craft's own selects, labelled the way the Debug toolbar's controls are —
       the CP's chrome rather than a look of our own. #}
    <form method="get" action="{{ cpUrl('influx/logs') }}" class="toolbar flex influx-logs-toolbar">
        {% for field in filterFields %}
            <div class="influx-logs-filter">
                <label class="influx-logs-filter-label" for="influx-filter-{{ field.name }}">{{ field.label }}</label>
                <div class="select">
                    <select id="influx-filter-{{ field.name }}" name="{{ field.name }}" data-influx-filter>
                        <option value="">{{ "All"|t("influx") }}</option>
                        {% for value, label in field.options %}
                            <option value="{{ value }}"{{ value == field.value ? " selected" }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        {% endfor %}

        {# A text link rather than a button: it undoes the filters beside it, it
           isn't a control of its own. #}
        {% if filterParams is not empty %}
            <a class="influx-logs-filters-clear" href="{{ cpUrl('influx/logs') }}">{{ "Clear filters"|t("influx") }}</a>
        {% endif %}
    </form>

    {% if logs is empty %}
        {# Two empty states, told apart by whether anything is on record at all:
           filters that matched nothing say how many runs they hid, so the way
           out is the toolbar right above; an empty log says what fills it. #}
        <div class="zilch influx-zilch">
            {% if filterParams is not empty and unfilteredTotal > 0 %}
                <h2>{{ "No runs match these filters"|t("influx") }}</h2>
                <p class="light">
                    {{ "{n, plural, =1{One run is} other{# runs are}} on record. Widen the link, trigger, status or result filter to see them."|t("influx", { n: unfilteredTotal }) }}
                </p>
            {% else %}
                <h2>{{ "No runs yet"|t("influx") }}</h2>
                <p class="light">{{ "Syncing a link records the run here — what it created, updated and skipped, item by item."|t("influx") }}</p>
            {% endif %}
        </div>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ "Run"|t("influx") }}</th>
                    <th>{{ "Link"|t("influx") }}</th>
                    <th>{{ "Trigger"|t("influx") }}</th>
                    <th>{{ "User"|t("influx") }}</th>
                    <th>{{ "Site"|t("influx") }}</th>
                    <th>{{ "Result"|t("influx") }}</th>
                    {% if canDelete %}<th class="thin"></th>{% endif %}
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr>
                        {# Run — status dot + when linking to the detail, duration
                           and seen count on the sub-line. #}
                        <td>
                            <span class="status {{ presenter.statusColor(log.status) }}" title="{{ log.status|t('influx') }}"></span>
                            <a href="{{ cpUrl('influx/logs/' ~ log.id) }}">
                                {{ craft.app.formattingLocale.getFormatter().asDatetime(log.startedAt, "short") }}
                            </a>
                            {% if presenter.isLive(log.status) %}
                                <div class="influx-cell-sub">{{ "running"|t("influx") }}</div>
                            {% else %}
                                {% set parts = [] %}
                                {% set duration = presenter.durationLabel(log) %}
                                {% if duration %}{% set parts = parts|merge([duration]) %}{% endif %}
                                {% if log.itemsSeen %}{% set parts = parts|merge([log.itemsSeen ~ " " ~ ui.resultNoun("seen")]) %}{% endif %}
                                {% if parts is not empty %}
                                    <div class="influx-cell-sub">{{ parts|join(" · ") }}</div>
                                {% endif %}
                            {% endif %}
                        </td>

                        {# Link — its chip, linking to the builder; a deleted link
                           has none left to chip and degrades to the handle the
                           run stored. #}
                        <td>
                            {% set linkChip = linkChips[log.linkHandle] ?? null %}
                            {% if linkChip %}
                                {{ linkChip }}
                            {% else %}
                                {{ log.linkHandle }}
                            {% endif %}
                        </td>

                        {# Trigger — the mechanism, plus the partial-import preset
                           it applied when there was one, both chipped like the
                           link and site beside them: a run's facts read as one
                           vocabulary even where the fact isn't a component. The
                           preset rides along here rather than in a column of its
                           own, which stood empty for every full run. #}
                        <td>
                            <div class="influx-pill-group">
                                {{ influxValueChip(triggers[log.trigger] ?? log.trigger) }}
                                {% if log.offsetHandle %}
                                    {{ influxValueChip(log.offsetHandle) }}
                                {% endif %}
                            </div>
                        </td>

                        {# User — the person who asked for the run, as their user
                           chip. Empty for a run nobody triggered (console, cron). #}
                        <td>
                            {% if log.userId %}
                                {{ userChips[log.userId] ?? "" }}
                            {% endif %}
                        </td>

                        {# Site the run was scoped to, as a Craft chip — a run with
                           no site scope chips the primary site, the same as the
                           Links overview. #}
                        <td>
                            {{ influxSiteChip(log.siteHandle) }}
                        </td>

                        {# Result — the six numeric columns as the shared pill
                           vocabulary. #}
                        <td>
                            {% set segments = presenter.resultSegments(log) %}
                            {% if segments is empty %}
                                <span class="light">{{ "no changes"|t("influx") }}</span>
                            {% else %}
                                <div class="influx-pill-group">
                                    {% for segment in segments %}{{ ui.resultPill(segment) }}{% endfor %}
                                </div>
                            {% endif %}
                        </td>

                        {# Delete — Craft's native row-delete icon; click → confirm
                           → submits the row's hidden form. The whole column is
                           gone without the delete permission, rather than an icon
                           that 403s. #}
                        {% if canDelete %}
                            <td class="thin action">
                                <form id="influx-delete-log-{{ log.id }}" method="post" accept-charset="UTF-8" hidden>
                                    {{ csrfInput() }}
                                    {{ actionInput("influx/logs/delete") }}
                                    {{ redirectInput("influx/logs") }}
                                    {{ hiddenInput("id", log.id) }}
                                </form>
                                <a class="delete icon"
                                   title="{{ 'Delete'|t('influx') }}"
                                   aria-label="{{ 'Delete'|t('influx') }}"
                                   role="button"
                                   data-influx-delete-form="influx-delete-log-{{ log.id }}"></a>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% set totalPages = (total / perPage)|round(0, "ceil") %}
        <div class="influx-table-foot">
            <span class="light">
                {{ total }} {{ (total == 1 ? "run" : "runs")|t("influx") }}
                {%- if retentionDays > 0 %} &middot; {{ "kept {n} days"|t("influx", { n: retentionDays }) }}{% endif -%}
            </span>
            {% if totalPages > 1 %}
                <nav class="pagination flex flex-nowrap">
                    {% if page > 1 %}
                        <a class="btn" href="{{ cpUrl('influx/logs', filterParams|merge({ page: page - 1 })) }}">&larr; {{ "Previous"|t("influx") }}</a>
                    {% endif %}
                    <span class="light">{{ "Page {page} of {total}"|t("influx", { page: page, total: totalPages }) }}</span>
                    {% if page < totalPages %}
                        <a class="btn" href="{{ cpUrl('influx/logs', filterParams|merge({ page: page + 1 })) }}">{{ "Next"|t("influx") }} &rarr;</a>
                    {% endif %}
                </nav>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
